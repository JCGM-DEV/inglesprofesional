# Opción 1: Groq (Gratis, ultra-rápido, recomendado)
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

